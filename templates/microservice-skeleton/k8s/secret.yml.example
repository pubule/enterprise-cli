# ═══════════════════════════════════════════════════════════════
# Kubernetes Secret for {{domainTitleCase}} Microservice
# Enterprise Framework v{{frameworkVersion}}
#
# IMPORTANT: This is an EXAMPLE file
# DO NOT commit actual secrets to version control!
#
# Usage:
# 1. Copy this file to secret.yml
# 2. Replace placeholder values with actual secrets
# 3. Encode values in base64: echo -n "value" | base64
# 4. Apply: kubectl apply -f secret.yml
# ═══════════════════════════════════════════════════════════════

apiVersion: v1
kind: Secret
metadata:
  name: {{serviceName}}-secret
  labels:
    app: {{serviceName}}
type: Opaque
data:
  {{#postgresql}}
  # PostgreSQL Credentials (base64 encoded)
  # Example: echo -n "postgres" | base64
  database.username: cG9zdGdyZXM=  # "postgres"
  database.password: cG9zdGdyZXM=  # "postgres"
  {{/postgresql}}

  {{#mysql}}
  # MySQL Credentials (base64 encoded)
  # Example: echo -n "root" | base64
  database.username: cm9vdA==  # "root"
  database.password: cm9vdA==  # "root"
  {{/mysql}}

  {{#hasAuth}}
  # JWT Secret (base64 encoded)
  # Example: openssl rand -base64 32 | tr -d '\n' | base64
  jwt.secret: YOUR_BASE64_ENCODED_JWT_SECRET_HERE

  # OAuth2 Client Credentials (base64 encoded)
  oauth2.client.id: YOUR_BASE64_ENCODED_CLIENT_ID_HERE
  oauth2.client.secret: YOUR_BASE64_ENCODED_CLIENT_SECRET_HERE
  {{/hasAuth}}

---

# ═══════════════════════════════════════════════════════════════
# How to create secrets from command line
# ═══════════════════════════════════════════════════════════════

# Create secret from literals:
# kubectl create secret generic {{serviceName}}-secret \
#   --from-literal=database.username=postgres \
#   --from-literal=database.password=postgres

# Create secret from file:
# kubectl create secret generic {{serviceName}}-secret \
#   --from-file=database.password=./db-password.txt

# View secret:
# kubectl get secret {{serviceName}}-secret -o yaml

# Decode secret value:
# kubectl get secret {{serviceName}}-secret -o jsonpath='{.data.database\.password}' | base64 --decode
