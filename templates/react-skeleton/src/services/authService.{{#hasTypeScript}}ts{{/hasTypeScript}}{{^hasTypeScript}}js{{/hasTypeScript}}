/**
 * Authentication Service
 *
 * Handles all authentication-related API calls including:
 * - Login/logout
 * - Registration
 * - Token refresh
 * - Token verification
 * - Password reset
 */
class AuthService {
  private readonly API_BASE = '/auth';

  /**
   * Authenticate user with email and password
   */
  async login(email{{#hasTypeScript}}: string{{/hasTypeScript}}, password{{#hasTypeScript}}: string{{/hasTypeScript}}){{#hasTypeScript}}: Promise<LoginResponse>{{/hasTypeScript}} {
    try {
      const response = await apiClient.post(`${this.API_BASE}/login`, {
        email,
        password,
      });

      return response.data;
    } catch (error) {
      this.handleAuthError(error);
      throw error;
    }
  }

  /**
   * Register new user account
   */
  async register(
    email{{#hasTypeScript}}: string{{/hasTypeScript}},
    password{{#hasTypeScript}}: string{{/hasTypeScript}},
    name{{#hasTypeScript}}: string{{/hasTypeScript}}
  ){{#hasTypeScript}}: Promise<RegisterResponse>{{/hasTypeScript}} {
    try {
      const response = await apiClient.post(`${this.API_BASE}/register`, {
        email,
        password,
        name,
      });

      return response.data;
    } catch (error) {
      this.handleAuthError(error);
      throw error;
    }
  }

  /**
   * Logout user and invalidate token
   */
  async logout(token{{#hasTypeScript}}: string{{/hasTypeScript}}){{#hasTypeScript}}: Promise<void>{{/hasTypeScript}} {
    try {
      await apiClient.post(
        `${this.API_BASE}/logout`,
        {},
        {
          headers: {
            Authorization: `Bearer ${token}`,
          },
        }
      );
    } catch (error) {
      // Log error but don't throw - logout should always succeed locally
      console.warn('Logout API call failed:', error);
    }
  }

  /**
   * Refresh authentication token
   */
  async refreshToken(refreshToken{{#hasTypeScript}}: string{{/hasTypeScript}}){{#hasTypeScript}}: Promise<RefreshTokenResponse>{{/hasTypeScript}} {
    try {
      const response = await apiClient.post(`${this.API_BASE}/refresh`, {
        refreshToken,
      });

      return response.data;
    } catch (error) {
      this.handleAuthError(error);
      throw error;
    }
  }

  /**
   * Verify token is still valid and get user data
   */
  async verifyToken(token{{#hasTypeScript}}: string{{/hasTypeScript}}){{#hasTypeScript}}: Promise<User>{{/hasTypeScript}} {
    try {
      const response = await apiClient.get(`${this.API_BASE}/verify`, {
        headers: {
          Authorization: `Bearer ${token}`,
        },
      });

      return response.data.user;
    } catch (error) {
      this.handleAuthError(error);
      throw error;
    }
  }

  /**
   * Get current user profile
   */
  async getCurrentUser(token{{#hasTypeScript}}: string{{/hasTypeScript}}){{#hasTypeScript}}: Promise<User>{{/hasTypeScript}} {
    try {
      const response = await apiClient.get(`${this.API_BASE}/me`, {
        headers: {
          Authorization: `Bearer ${token}`,
        },
      });

      return response.data;
    } catch (error) {
      this.handleAuthError(error);
      throw error;
    }
  }

  /**
   * Update user profile
   */
  async updateProfile(
    token{{#hasTypeScript}}: string{{/hasTypeScript}},
    userData{{#hasTypeScript}}: Partial<User>{{/hasTypeScript}}
  ){{#hasTypeScript}}: Promise<User>{{/hasTypeScript}} {
    try {
      const response = await apiClient.put(`${this.API_BASE}/profile`, userData, {
        headers: {
          Authorization: `Bearer ${token}`,
        },
      });

      return response.data;
    } catch (error) {
      this.handleAuthError(error);
      throw error;
    }
  }

  /**
   * Change user password
   */
  async changePassword(
    token{{#hasTypeScript}}: string{{/hasTypeScript}},
    currentPassword{{#hasTypeScript}}: string{{/hasTypeScript}},
    newPassword{{#hasTypeScript}}: string{{/hasTypeScript}}
  ){{#hasTypeScript}}: Promise<void>{{/hasTypeScript}} {
    try {
      await apiClient.post(
        `${this.API_BASE}/change-password`,
        {
          currentPassword,
          newPassword,
        },
        {
          headers: {
            Authorization: `Bearer ${token}`,
          },
        }
      );
    } catch (error) {
      this.handleAuthError(error);
      throw error;
    }
  }

  /**
   * Request password reset
   */
  async requestPasswordReset(email{{#hasTypeScript}}: string{{/hasTypeScript}}){{#hasTypeScript}}: Promise<void>{{/hasTypeScript}} {
    try {
      await apiClient.post(`${this.API_BASE}/forgot-password`, {
        email,
      });
    } catch (error) {
      this.handleAuthError(error);
      throw error;
    }
  }

  /**
   * Reset password with token
   */
  async resetPassword(
    token{{#hasTypeScript}}: string{{/hasTypeScript}},
    newPassword{{#hasTypeScript}}: string{{/hasTypeScript}}
  ){{#hasTypeScript}}: Promise<void>{{/hasTypeScript}} {
    try {
      await apiClient.post(`${this.API_BASE}/reset-password`, {
        token,
        newPassword,
      });
    } catch (error) {
      this.handleAuthError(error);
      throw error;
    }
  }

  /**
   * Send email verification
   */
  async sendEmailVerification(token{{#hasTypeScript}}: string{{/hasTypeScript}}){{#hasTypeScript}}: Promise<void>{{/hasTypeScript}} {
    try {
      await apiClient.post(
        `${this.API_BASE}/send-verification`,
        {},
        {
          headers: {
            Authorization: `Bearer ${token}`,
          },
        }
      );
    } catch (error) {
      this.handleAuthError(error);
      throw error;
    }
  }

  /**
   * Verify email with token
   */
  async verifyEmail(verificationToken{{#hasTypeScript}}: string{{/hasTypeScript}}){{#hasTypeScript}}: Promise<void>{{/hasTypeScript}} {
    try {
      await apiClient.post(`${this.API_BASE}/verify-email`, {
        token: verificationToken,
      });
    } catch (error) {
      this.handleAuthError(error);
      throw error;
    }
  }

  /**
   * Enable two-factor authentication
   */
  async enableTwoFactor(token{{#hasTypeScript}}: string{{/hasTypeScript}}){{#hasTypeScript}}: Promise<{ qrCode: string; secret: string }>{{/hasTypeScript}} {
    try {
      const response = await apiClient.post(
        `${this.API_BASE}/2fa/enable`,
        {},
        {
          headers: {
            Authorization: `Bearer ${token}`,
          },
        }
      );

      return response.data;
    } catch (error) {
      this.handleAuthError(error);
      throw error;
    }
  }

  /**
   * Verify two-factor authentication code
   */
  async verifyTwoFactor(
    token{{#hasTypeScript}}: string{{/hasTypeScript}},
    code{{#hasTypeScript}}: string{{/hasTypeScript}}
  ){{#hasTypeScript}}: Promise<void>{{/hasTypeScript}} {
    try {
      await apiClient.post(
        `${this.API_BASE}/2fa/verify`,
        { code },
        {
          headers: {
            Authorization: `Bearer ${token}`,
          },
        }
      );
    } catch (error) {
      this.handleAuthError(error);
      throw error;
    }
  }

  /**
   * Disable two-factor authentication
   */
  async disableTwoFactor(
    token{{#hasTypeScript}}: string{{/hasTypeScript}},
    code{{#hasTypeScript}}: string{{/hasTypeScript}}
  ){{#hasTypeScript}}: Promise<void>{{/hasTypeScript}} {
    try {
      await apiClient.post(
        `${this.API_BASE}/2fa/disable`,
        { code },
        {
          headers: {
            Authorization: `Bearer ${token}`,
          },
        }
      );
    } catch (error) {
      this.handleAuthError(error);
      throw error;
    }
  }

  /**
   * Handle authentication errors
   */
  private handleAuthError(error{{#hasTypeScript}}: any{{/hasTypeScript}}) {
    if (error.response) {
      // Server responded with error status
      const { status, data } = error.response;

      switch (status) {
        case 401:
          throw new Error(data.message || 'Invalid credentials');
        case 403:
          throw new Error(data.message || 'Access forbidden');
        case 422:
          throw new Error(data.message || 'Validation failed');
        case 429:
          throw new Error(data.message || 'Too many requests. Please try again later.');
        case 500:
          throw new Error('Server error. Please try again later.');
        default:
          throw new Error(data.message || 'Authentication failed');
      }
    } else if (error.request) {
      // Network error
      throw new Error('Network error. Please check your connection.');
    } else {
      // Other error
      throw new Error(error.message || 'An unexpected error occurred');
    }
  }
}

// Export singleton instance
export const authService = new AuthService();