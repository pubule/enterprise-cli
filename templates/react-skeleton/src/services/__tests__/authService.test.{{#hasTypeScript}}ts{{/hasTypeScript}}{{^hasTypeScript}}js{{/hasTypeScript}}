{{#hasTypeScript}}import { authService } from '../authService';{{/hasTypeScript}}{{^hasTypeScript}}import { authService } from '../authService';{{/hasTypeScript}}
import { apiClient } from '../apiClient';
import { testUtils, mockApiResponse, mockApiError } from '../../utils/test-utils';

// Mock the API client
jest.mock('../apiClient');
const mockApiClient = apiClient {{#hasTypeScript}}as jest.Mocked<typeof apiClient>{{/hasTypeScript}};

describe('AuthService', () => {
  beforeEach(() => {
    jest.clearAllMocks();
  });

  describe('login', () => {
    const loginCredentials = {
      email: 'test@example.com',
      password: 'password123',
    };

    const mockLoginResponse = {
      user: testUtils.mockUser,
      token: 'mock-jwt-token',
      refreshToken: 'mock-refresh-token',
    };

    it('makes correct API call for login', async () => {
      mockApiClient.post.mockResolvedValue(mockApiResponse(mockLoginResponse));

      const result = await authService.login(loginCredentials.email, loginCredentials.password);

      expect(mockApiClient.post).toHaveBeenCalledWith('/auth/login', {
        email: loginCredentials.email,
        password: loginCredentials.password,
      });

      expect(result).toEqual(mockLoginResponse);
    });

    it('handles login success', async () => {
      mockApiClient.post.mockResolvedValue(mockApiResponse(mockLoginResponse));

      const result = await authService.login(loginCredentials.email, loginCredentials.password);

      expect(result.user).toEqual(testUtils.mockUser);
      expect(result.token).toBe('mock-jwt-token');
      expect(result.refreshToken).toBe('mock-refresh-token');
    });

    it('handles invalid credentials error', async () => {
      const errorResponse = mockApiError('Invalid credentials', 401);
      mockApiClient.post.mockRejectedValue(errorResponse);

      await expect(
        authService.login(loginCredentials.email, loginCredentials.password)
      ).rejects.toThrow('Invalid credentials');
    });

    it('handles validation errors', async () => {
      const errorResponse = mockApiError('Validation failed', 422);
      mockApiClient.post.mockRejectedValue(errorResponse);

      await expect(
        authService.login(loginCredentials.email, loginCredentials.password)
      ).rejects.toThrow('Validation failed');
    });

    it('handles rate limiting', async () => {
      const errorResponse = mockApiError('Too many requests', 429);
      mockApiClient.post.mockRejectedValue(errorResponse);

      await expect(
        authService.login(loginCredentials.email, loginCredentials.password)
      ).rejects.toThrow('Too many requests. Please try again later.');
    });

    it('handles server errors', async () => {
      const errorResponse = mockApiError('Internal server error', 500);
      mockApiClient.post.mockRejectedValue(errorResponse);

      await expect(
        authService.login(loginCredentials.email, loginCredentials.password)
      ).rejects.toThrow('Server error. Please try again later.');
    });

    it('handles network errors', async () => {
      const networkError = new Error('Network error');
      networkError.request = {}; // Simulate network error
      mockApiClient.post.mockRejectedValue(networkError);

      await expect(
        authService.login(loginCredentials.email, loginCredentials.password)
      ).rejects.toThrow('Network error. Please check your connection.');
    });
  });

  describe('register', () => {
    const registerData = {
      email: 'newuser@example.com',
      password: 'password123',
      name: 'New User',
    };

    const mockRegisterResponse = {
      user: {
        ...testUtils.mockUser,
        email: registerData.email,
        name: registerData.name,
      },
      token: 'mock-jwt-token',
      refreshToken: 'mock-refresh-token',
    };

    it('makes correct API call for registration', async () => {
      mockApiClient.post.mockResolvedValue(mockApiResponse(mockRegisterResponse));

      const result = await authService.register(
        registerData.email,
        registerData.password,
        registerData.name
      );

      expect(mockApiClient.post).toHaveBeenCalledWith('/auth/register', {
        email: registerData.email,
        password: registerData.password,
        name: registerData.name,
      });

      expect(result).toEqual(mockRegisterResponse);
    });

    it('handles email already exists error', async () => {
      const errorResponse = mockApiError('Email already exists', 409);
      mockApiClient.post.mockRejectedValue(errorResponse);

      await expect(
        authService.register(registerData.email, registerData.password, registerData.name)
      ).rejects.toThrow('Email already exists');
    });
  });

  describe('logout', () => {
    const mockToken = 'mock-jwt-token';

    it('makes correct API call for logout', async () => {
      mockApiClient.post.mockResolvedValue(mockApiResponse({}));

      await authService.logout(mockToken);

      expect(mockApiClient.post).toHaveBeenCalledWith(
        '/auth/logout',
        {},
        {
          headers: {
            Authorization: `Bearer ${mockToken}`,
          },
        }
      );
    });

    it('handles logout errors gracefully', async () => {
      const errorResponse = mockApiError('Logout failed', 500);
      mockApiClient.post.mockRejectedValue(errorResponse);

      // Should not throw error, just log warning
      await expect(authService.logout(mockToken)).resolves.toBeUndefined();
    });
  });

  describe('refreshToken', () => {
    const mockRefreshToken = 'mock-refresh-token';
    const mockRefreshResponse = {
      token: 'new-jwt-token',
      refreshToken: 'new-refresh-token',
    };

    it('makes correct API call for token refresh', async () => {
      mockApiClient.post.mockResolvedValue(mockApiResponse(mockRefreshResponse));

      const result = await authService.refreshToken(mockRefreshToken);

      expect(mockApiClient.post).toHaveBeenCalledWith('/auth/refresh', {
        refreshToken: mockRefreshToken,
      });

      expect(result).toEqual(mockRefreshResponse);
    });

    it('handles invalid refresh token', async () => {
      const errorResponse = mockApiError('Invalid refresh token', 401);
      mockApiClient.post.mockRejectedValue(errorResponse);

      await expect(authService.refreshToken(mockRefreshToken)).rejects.toThrow(
        'Invalid refresh token'
      );
    });
  });

  describe('verifyToken', () => {
    const mockToken = 'mock-jwt-token';

    it('makes correct API call for token verification', async () => {
      mockApiClient.get.mockResolvedValue(mockApiResponse({ user: testUtils.mockUser }));

      const result = await authService.verifyToken(mockToken);

      expect(mockApiClient.get).toHaveBeenCalledWith('/auth/verify', {
        headers: {
          Authorization: `Bearer ${mockToken}`,
        },
      });

      expect(result).toEqual(testUtils.mockUser);
    });

    it('handles invalid token', async () => {
      const errorResponse = mockApiError('Invalid token', 401);
      mockApiClient.get.mockRejectedValue(errorResponse);

      await expect(authService.verifyToken(mockToken)).rejects.toThrow('Invalid token');
    });
  });

  describe('getCurrentUser', () => {
    const mockToken = 'mock-jwt-token';

    it('makes correct API call to get current user', async () => {
      mockApiClient.get.mockResolvedValue(mockApiResponse(testUtils.mockUser));

      const result = await authService.getCurrentUser(mockToken);

      expect(mockApiClient.get).toHaveBeenCalledWith('/auth/me', {
        headers: {
          Authorization: `Bearer ${mockToken}`,
        },
      });

      expect(result).toEqual(testUtils.mockUser);
    });
  });

  describe('updateProfile', () => {
    const mockToken = 'mock-jwt-token';
    const updateData = {
      name: 'Updated Name',
      email: 'updated@example.com',
    };

    it('makes correct API call for profile update', async () => {
      const updatedUser = { ...testUtils.mockUser, ...updateData };
      mockApiClient.put.mockResolvedValue(mockApiResponse(updatedUser));

      const result = await authService.updateProfile(mockToken, updateData);

      expect(mockApiClient.put).toHaveBeenCalledWith('/auth/profile', updateData, {
        headers: {
          Authorization: `Bearer ${mockToken}`,
        },
      });

      expect(result).toEqual(updatedUser);
    });
  });

  describe('changePassword', () => {
    const mockToken = 'mock-jwt-token';
    const passwordData = {
      currentPassword: 'oldpassword',
      newPassword: 'newpassword123',
    };

    it('makes correct API call for password change', async () => {
      mockApiClient.post.mockResolvedValue(mockApiResponse({}));

      await authService.changePassword(
        mockToken,
        passwordData.currentPassword,
        passwordData.newPassword
      );

      expect(mockApiClient.post).toHaveBeenCalledWith(
        '/auth/change-password',
        {
          currentPassword: passwordData.currentPassword,
          newPassword: passwordData.newPassword,
        },
        {
          headers: {
            Authorization: `Bearer ${mockToken}`,
          },
        }
      );
    });

    it('handles incorrect current password', async () => {
      const errorResponse = mockApiError('Incorrect current password', 400);
      mockApiClient.post.mockRejectedValue(errorResponse);

      await expect(
        authService.changePassword(
          mockToken,
          passwordData.currentPassword,
          passwordData.newPassword
        )
      ).rejects.toThrow('Incorrect current password');
    });
  });

  describe('requestPasswordReset', () => {
    const email = 'test@example.com';

    it('makes correct API call for password reset request', async () => {
      mockApiClient.post.mockResolvedValue(mockApiResponse({}));

      await authService.requestPasswordReset(email);

      expect(mockApiClient.post).toHaveBeenCalledWith('/auth/forgot-password', {
        email,
      });
    });

    it('handles non-existent email gracefully', async () => {
      const errorResponse = mockApiError('Email not found', 404);
      mockApiClient.post.mockRejectedValue(errorResponse);

      await expect(authService.requestPasswordReset(email)).rejects.toThrow('Email not found');
    });
  });

  describe('resetPassword', () => {
    const resetData = {
      token: 'reset-token',
      newPassword: 'newpassword123',
    };

    it('makes correct API call for password reset', async () => {
      mockApiClient.post.mockResolvedValue(mockApiResponse({}));

      await authService.resetPassword(resetData.token, resetData.newPassword);

      expect(mockApiClient.post).toHaveBeenCalledWith('/auth/reset-password', {
        token: resetData.token,
        newPassword: resetData.newPassword,
      });
    });

    it('handles invalid reset token', async () => {
      const errorResponse = mockApiError('Invalid or expired reset token', 400);
      mockApiClient.post.mockRejectedValue(errorResponse);

      await expect(
        authService.resetPassword(resetData.token, resetData.newPassword)
      ).rejects.toThrow('Invalid or expired reset token');
    });
  });

  describe('sendEmailVerification', () => {
    const mockToken = 'mock-jwt-token';

    it('makes correct API call for email verification', async () => {
      mockApiClient.post.mockResolvedValue(mockApiResponse({}));

      await authService.sendEmailVerification(mockToken);

      expect(mockApiClient.post).toHaveBeenCalledWith(
        '/auth/send-verification',
        {},
        {
          headers: {
            Authorization: `Bearer ${mockToken}`,
          },
        }
      );
    });
  });

  describe('verifyEmail', () => {
    const verificationToken = 'verification-token';

    it('makes correct API call for email verification', async () => {
      mockApiClient.post.mockResolvedValue(mockApiResponse({}));

      await authService.verifyEmail(verificationToken);

      expect(mockApiClient.post).toHaveBeenCalledWith('/auth/verify-email', {
        token: verificationToken,
      });
    });

    it('handles invalid verification token', async () => {
      const errorResponse = mockApiError('Invalid verification token', 400);
      mockApiClient.post.mockRejectedValue(errorResponse);

      await expect(authService.verifyEmail(verificationToken)).rejects.toThrow(
        'Invalid verification token'
      );
    });
  });

  describe('Two-Factor Authentication', () => {
    const mockToken = 'mock-jwt-token';

    describe('enableTwoFactor', () => {
      const mockTwoFactorResponse = {
        qrCode: 'data:image/png;base64,mock-qr-code',
        secret: 'mock-secret',
      };

      it('makes correct API call to enable 2FA', async () => {
        mockApiClient.post.mockResolvedValue(mockApiResponse(mockTwoFactorResponse));

        const result = await authService.enableTwoFactor(mockToken);

        expect(mockApiClient.post).toHaveBeenCalledWith(
          '/auth/2fa/enable',
          {},
          {
            headers: {
              Authorization: `Bearer ${mockToken}`,
            },
          }
        );

        expect(result).toEqual(mockTwoFactorResponse);
      });
    });

    describe('verifyTwoFactor', () => {
      const mockCode = '123456';

      it('makes correct API call to verify 2FA', async () => {
        mockApiClient.post.mockResolvedValue(mockApiResponse({}));

        await authService.verifyTwoFactor(mockToken, mockCode);

        expect(mockApiClient.post).toHaveBeenCalledWith(
          '/auth/2fa/verify',
          { code: mockCode },
          {
            headers: {
              Authorization: `Bearer ${mockToken}`,
            },
          }
        );
      });

      it('handles invalid 2FA code', async () => {
        const errorResponse = mockApiError('Invalid 2FA code', 400);
        mockApiClient.post.mockRejectedValue(errorResponse);

        await expect(authService.verifyTwoFactor(mockToken, mockCode)).rejects.toThrow(
          'Invalid 2FA code'
        );
      });
    });

    describe('disableTwoFactor', () => {
      const mockCode = '123456';

      it('makes correct API call to disable 2FA', async () => {
        mockApiClient.post.mockResolvedValue(mockApiResponse({}));

        await authService.disableTwoFactor(mockToken, mockCode);

        expect(mockApiClient.post).toHaveBeenCalledWith(
          '/auth/2fa/disable',
          { code: mockCode },
          {
            headers: {
              Authorization: `Bearer ${mockToken}`,
            },
          }
        );
      });
    });
  });

  describe('Error Handling', () => {
    it('properly formats error messages for different HTTP status codes', async () => {
      const testCases = [
        { status: 401, expectedMessage: 'Invalid credentials' },
        { status: 403, expectedMessage: 'Access forbidden' },
        { status: 422, expectedMessage: 'Validation failed' },
        { status: 429, expectedMessage: 'Too many requests. Please try again later.' },
        { status: 500, expectedMessage: 'Server error. Please try again later.' },
      ];

      for (const testCase of testCases) {
        const errorResponse = mockApiError('Original message', testCase.status);
        mockApiClient.post.mockRejectedValue(errorResponse);

        await expect(authService.login('test@example.com', 'password')).rejects.toThrow(
          testCase.expectedMessage
        );
      }
    });

    it('handles unknown error responses', async () => {
      const errorResponse = mockApiError('Unknown error', 418); // I'm a teapot
      mockApiClient.post.mockRejectedValue(errorResponse);

      await expect(authService.login('test@example.com', 'password')).rejects.toThrow(
        'Authentication failed'
      );
    });

    it('handles errors without response object', async () => {
      const error = new Error('Generic error');
      mockApiClient.post.mockRejectedValue(error);

      await expect(authService.login('test@example.com', 'password')).rejects.toThrow(
        'An unexpected error occurred'
      );
    });
  });

  describe('Performance', () => {
    it('handles multiple concurrent requests', async () => {
      const mockResponse = mockApiResponse({ user: testUtils.mockUser });
      mockApiClient.get.mockResolvedValue(mockResponse);

      const promises = Array.from({ length: 10 }, () =>
        authService.getCurrentUser('mock-token')
      );

      const results = await Promise.all(promises);

      expect(results).toHaveLength(10);
      expect(mockApiClient.get).toHaveBeenCalledTimes(10);
      results.forEach(result => {
        expect(result).toEqual(testUtils.mockUser);
      });
    });

    it('handles request timeouts', async () => {
      const timeoutError = new Error('Request timeout');
      timeoutError.code = 'ECONNABORTED';
      mockApiClient.post.mockRejectedValue(timeoutError);

      await expect(authService.login('test@example.com', 'password')).rejects.toThrow(
        'Request timeout'
      );
    });
  });
});