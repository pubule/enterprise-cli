// Action types
const LOADING_ACTIONS = {
  SET_GLOBAL_LOADING: 'SET_GLOBAL_LOADING',
  SET_TASK_LOADING: 'SET_TASK_LOADING',
  CLEAR_ALL_LOADING: 'CLEAR_ALL_LOADING',
};

// Initial state
{{#hasTypeScript}}const initialState: LoadingState = {{{/hasTypeScript}}{{^hasTypeScript}}const initialState = {{{/hasTypeScript}}
  global: false,
  tasks: {},
};

// Reducer
{{#hasTypeScript}}function loadingReducer(state: LoadingState, action: LoadingAction): LoadingState {{{/hasTypeScript}}{{^hasTypeScript}}function loadingReducer(state, action) {{{/hasTypeScript}}
  switch (action.type) {
    case LOADING_ACTIONS.SET_GLOBAL_LOADING:
      return {
        ...state,
        global: action.payload,
      };

    case LOADING_ACTIONS.SET_TASK_LOADING:
      const { taskId, loading } = action.payload;
      const newTasks = { ...state.tasks };

      if (loading) {
        newTasks[taskId] = true;
      } else {
        delete newTasks[taskId];
      }

      return {
        ...state,
        tasks: newTasks,
      };

    case LOADING_ACTIONS.CLEAR_ALL_LOADING:
      return {
        global: false,
        tasks: {},
      };

    default:
      return state;
  }
}

// Create context
{{#hasTypeScript}}const LoadingContext = createContext<LoadingContextType | undefined>(undefined);{{/hasTypeScript}}{{^hasTypeScript}}const LoadingContext = createContext();{{/hasTypeScript}}

// Provider component
{{#hasTypeScript}}export const LoadingProvider: React.FC<LoadingProviderProps> = ({ children }) => {{{/hasTypeScript}}{{^hasTypeScript}}export const LoadingProvider = ({ children }) => {{{/hasTypeScript}}
  const [state, dispatch] = useReducer(loadingReducer, initialState);

  // Set global loading
  const setGlobalLoading = (loading{{#hasTypeScript}}: boolean{{/hasTypeScript}}) => {
    dispatch({
      type: LOADING_ACTIONS.SET_GLOBAL_LOADING,
      payload: loading,
    });
  };

  // Set task-specific loading
  const setTaskLoading = (taskId{{#hasTypeScript}}: string{{/hasTypeScript}}, loading{{#hasTypeScript}}: boolean{{/hasTypeScript}}) => {
    dispatch({
      type: LOADING_ACTIONS.SET_TASK_LOADING,
      payload: { taskId, loading },
    });
  };

  // Check if specific task is loading
  const isTaskLoading = (taskId{{#hasTypeScript}}: string{{/hasTypeScript}}) => {
    return Boolean(state.tasks[taskId]);
  };

  // Check if any task is loading
  const isAnyLoading = () => {
    return state.global || Object.keys(state.tasks).length > 0;
  };

  // Clear all loading states
  const clearAllLoading = () => {
    dispatch({ type: LOADING_ACTIONS.CLEAR_ALL_LOADING });
  };

  const value = {
    ...state,
    setGlobalLoading,
    setTaskLoading,
    isTaskLoading,
    isAnyLoading,
    clearAllLoading,
  };

  return (
