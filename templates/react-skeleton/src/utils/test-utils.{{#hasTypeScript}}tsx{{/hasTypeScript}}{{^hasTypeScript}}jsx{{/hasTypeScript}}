/**
 * Custom render function with all providers
 */
export const renderWithProviders = (
  ui{{#hasTypeScript}}: ReactElement{{/hasTypeScript}},
  options{{#hasTypeScript}}: CustomRenderOptions{{/hasTypeScript}} = {}
){{#hasTypeScript}}: RenderResult & { store: typeof store; queryClient: QueryClient }{{/hasTypeScript}} => {
  const {
    initialEntries = ['/'],
    preloadedState,
    withRouter = true,
    withAuth = true,
    withQuery = true,
    withTheme = true,
    withNotifications = true,
    mockUser = defaultMockUser,
    queryClientOptions,
    customWrappers = [],
    ...renderOptions
  } = options;

  // Create query client
  const queryClient = createTestQueryClient(queryClientOptions);

  // Build wrapper component
  const AllTheProviders = ({ children }{{#hasTypeScript}}: { children: ReactNode }{{/hasTypeScript}}) => {
    let content = children;

    // Wrap with custom wrappers
    customWrappers.forEach((Wrapper) => {
      content = <Wrapper>{content}</Wrapper>;
    });

    // Redux Provider
    content = <Provider store={store}>{content}</Provider>;

    // React Query Provider
    if (withQuery) {
      content = <QueryClientProvider client={queryClient}>{content}</QueryClientProvider>;
    }

    // Router Provider
    if (withRouter) {
      content = (
        <BrowserRouter>
          {content}
        </BrowserRouter>
      );
    }

    // Theme Provider
    if (withTheme) {
      {{#isMaterialUI}}
      content = (
        <ThemeProvider theme={testTheme}>
          <AppThemeProvider>
            {content}
          </AppThemeProvider>
        </ThemeProvider>
      );{{/isMaterialUI}}
      {{#isAntDesign}}
      content = (
        <ConfigProvider>
          <AppThemeProvider>
            {content}
          </AppThemeProvider>
        </ConfigProvider>
      );{{/isAntDesign}}
    }

    // Auth Provider
    if (withAuth) {
      content = <AuthProvider>{content}</AuthProvider>;
    }

    // Loading Provider
    content = <LoadingProvider>{content}</LoadingProvider>;

    // Notification Provider
    if (withNotifications) {
      content = <NotificationProvider>{content}</NotificationProvider>;
    }

    return <>{content}</>;
  };

  const result = render(ui, {
    wrapper: AllTheProviders,
    ...renderOptions,
  });

  return {
    ...result,
    store,
    queryClient,
  };
};

