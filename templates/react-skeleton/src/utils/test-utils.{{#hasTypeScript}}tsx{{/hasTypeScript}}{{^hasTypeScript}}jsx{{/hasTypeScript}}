// Setup function for tests
export const setupTests = () => {
  // Mock console methods in tests
  global.console = {
    ...console,
    log: jest.fn(),
    warn: jest.fn(),
    error: jest.fn(),
  };

  // Mock window.alert
  window.alert = jest.fn();

  // Mock window.confirm
  window.confirm = jest.fn();

  // Mock window.prompt
  window.prompt = jest.fn();

  // Setup common mocks
  mockIntersectionObserver();
  mockResizeObserver();
  mockLocalStorage();

  // Mock window.URL.createObjectURL
  window.URL.createObjectURL = jest.fn(() => 'blob:mock-url');
  window.URL.revokeObjectURL = jest.fn();

  // Mock fetch if not already mocked
  if (!global.fetch) {
    global.fetch = jest.fn();
  }
};

// Cleanup function for tests
export const cleanupTests = () => {
  // Clear all mocks
  jest.clearAllMocks();

  // Clear local storage
  if (window.localStorage) {
    window.localStorage.clear();
  }

  // Clear session storage
  if (window.sessionStorage) {
    window.sessionStorage.clear();
  }
};

// Custom matchers for better assertions
export const customMatchers = {
  toHaveLoadingState: (element{{#hasTypeScript}}: Element{{/hasTypeScript}}) => {
    const hasLoadingIndicator = element.querySelector('[data-testid="loading"]') !== null;
    const hasLoadingText = element.textContent?.includes('Loading') || false;

    return {
      pass: hasLoadingIndicator || hasLoadingText,
      message: () => hasLoadingIndicator || hasLoadingText
        ? 'Element has loading state'
        : 'Element does not have loading state',
    };
  },

  toHaveErrorState: (element{{#hasTypeScript}}: Element{{/hasTypeScript}}) => {
    const hasErrorMessage = element.querySelector('[role="alert"]') !== null;
    const hasErrorText = element.textContent?.includes('Error') || false;

    return {
      pass: hasErrorMessage || hasErrorText,
      message: () => hasErrorMessage || hasErrorText
        ? 'Element has error state'
        : 'Element does not have error state',
    };
  },
};