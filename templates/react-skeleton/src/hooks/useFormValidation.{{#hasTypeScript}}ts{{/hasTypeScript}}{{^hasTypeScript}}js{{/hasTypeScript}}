  const getFieldError = useCallback((fieldName{{#hasTypeScript}}: string{{/hasTypeScript}}){{#hasTypeScript}}: string | undefined{{/hasTypeScript}} => {
    return errors[fieldName];
  }, [errors]);

  /**
   * Check if field is touched
   */
  const isFieldTouched = useCallback((fieldName{{#hasTypeScript}}: string{{/hasTypeScript}}){{#hasTypeScript}}: boolean{{/hasTypeScript}} => {
    return Boolean(touched[fieldName]);
  }, [touched]);

  /**
   * Check if field is valid
