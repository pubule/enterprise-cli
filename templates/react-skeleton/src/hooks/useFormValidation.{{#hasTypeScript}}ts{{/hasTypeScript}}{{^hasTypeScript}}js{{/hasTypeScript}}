  /**
   * Validate all fields
   */
  const validateAll = useCallback(async (){{#hasTypeScript}}: Promise<boolean>{{/hasTypeScript}} => {
    return validate();
  }, [validate]);

  /**
   * Clear errors for specific field or all fields
   */
  const clearErrors = useCallback((fieldName{{#hasTypeScript}}?: string{{/hasTypeScript}}) => {
    if (fieldName) {
      setErrors(prev => {
        const newErrors = { ...prev };
        delete newErrors[fieldName];
        return newErrors;
      });
    } else {
      setErrors({});
    }
  }, []);

  /**
   * Clear touched state for specific field or all fields
   */
  const clearTouched = useCallback((fieldName{{#hasTypeScript}}?: string{{/hasTypeScript}}) => {
    if (fieldName) {
      setTouched(prev => {
        const newTouched = { ...prev };
        delete newTouched[fieldName];
        return newTouched;
      });
    } else {
      setTouched({});
    }
  }, []);

  /**
   * Set error for specific field
   */
  const setFieldError = useCallback((fieldName{{#hasTypeScript}}: string{{/hasTypeScript}}, error{{#hasTypeScript}}: string{{/hasTypeScript}}) => {
    setErrors(prev => ({
      ...prev,
      [fieldName]: error,
