 *
 * @param formData - Current form data
 * @param validationConfig - Validation rules for each field
 * @param options - Validation options
 * @returns Validation state and methods
 */
export const useFormValidation = {{#hasTypeScript}}<T extends Record<string, any>>{{/hasTypeScript}}(
  formData{{#hasTypeScript}}: T{{/hasTypeScript}},
  validationConfig{{#hasTypeScript}}: FieldConfig{{/hasTypeScript}},
  options{{#hasTypeScript}}: UseFormValidationOptions{{/hasTypeScript}} = {}
){{#hasTypeScript}}: UseFormValidationReturn<T>{{/hasTypeScript}} => {
  const {
    validateOnChange = true,
    validateOnBlur = true,
    validateOnSubmit = true,
    debounceMs = 300,
    resetOnSubmit = false,
  } = options;

  const [errors, setErrors] = useState{{#hasTypeScript}}<ValidationError>{{/hasTypeScript}}({});
  const [touched, setTouched] = useState{{#hasTypeScript}}<TouchedFields>{{/hasTypeScript}}({});
  const [isValidating, setIsValidating] = useState(false);

  // Debounced validation timer
  const [validationTimer, setValidationTimer] = useState{{#hasTypeScript}}<NodeJS.Timeout | null>{{/hasTypeScript}}(null);

  // Built-in validation patterns
  const patterns = useMemo(() => ({
    email: /^[^\s@]+@[^\s@]+\.[^\s@]+$/,
    url: /^https?:\/\/(www\.)?[-a-zA-Z0-9@:%._\+~#=]{1,256}\.[a-zA-Z0-9()]{1,6}\b([-a-zA-Z0-9()@:%_\+.~#?&//=]*)$/,
    phone: /^[\+]?[(]?[\+]?\d{2,3}[)]?[-\s\.]?\d{3,4}[-\s\.]?\d{4,6}$/,
    number: /^-?\d*\.?\d+$/,
    integer: /^-?\d+$/,
