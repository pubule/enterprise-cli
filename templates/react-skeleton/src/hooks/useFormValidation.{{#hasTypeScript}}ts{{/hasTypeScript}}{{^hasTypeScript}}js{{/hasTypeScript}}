        return !error;
      } else {
        // Validate all fields
        const newErrors = {};
        let isValid = true;

        for (const [field, config] of Object.entries(validationConfig)) {
          const error = await validateField(field, formData[field]);
          if (error) {
            newErrors[field] = error;
            isValid = false;
          }
