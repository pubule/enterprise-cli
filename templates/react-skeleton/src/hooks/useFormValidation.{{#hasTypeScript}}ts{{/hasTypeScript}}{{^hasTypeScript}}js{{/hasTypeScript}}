  const validateField = useCallback(async (fieldName{{#hasTypeScript}}: string{{/hasTypeScript}}, value{{#hasTypeScript}}: any{{/hasTypeScript}}){{#hasTypeScript}}: Promise<string | null>{{/hasTypeScript}} => {
    const config = validationConfig[fieldName];
    if (!config) return null;

    // Check if field should be validated based on conditions
    if (config.conditional && !config.conditional(formData)) {
      return null;
    }

    // Required validation
    if (config.required) {
      const isEmpty = value === undefined || value === null || value === '' ||
                     (Array.isArray(value) && value.length === 0);

      if (isEmpty) {
        return getErrorMessage('required', value, config.required, fieldName);
      }
    }

    // Skip other validations if value is empty and not required
    if (value === undefined || value === null || value === '') {
      return null;
    }

    // Type-specific validations
    if (config.email && !patterns.email.test(String(value))) {
      return getErrorMessage('email', value, config.email, fieldName);
    }

    if (config.url && !patterns.url.test(String(value))) {
      return getErrorMessage('url', value, config.url, fieldName);
    }

    if (config.phone && !patterns.phone.test(String(value))) {
      return getErrorMessage('phone', value, config.phone, fieldName);
    }

    if (config.number && !patterns.number.test(String(value))) {
      return getErrorMessage('number', value, config.number, fieldName);
    }

    if (config.integer && !patterns.integer.test(String(value))) {
      return getErrorMessage('integer', value, config.integer, fieldName);
    }

    // Pattern validation
    if (config.pattern) {
      const regex = typeof config.pattern === 'string' ? new RegExp(config.pattern) : config.pattern;
      if (!regex.test(String(value))) {
        return getErrorMessage('pattern', value, config.pattern, fieldName);
      }
    }

    // Length validations
    if (config.minLength !== undefined) {
      const length = String(value).length;
      if (length < Number(config.minLength)) {
        return getErrorMessage('minLength', value, config.minLength, fieldName);
      }
    }

    if (config.maxLength !== undefined) {
      const length = String(value).length;
      if (length > Number(config.maxLength)) {
        return getErrorMessage('maxLength', value, config.maxLength, fieldName);
      }
    }

    // Numeric validations
    if (config.min !== undefined) {
      const numValue = Number(value);
      if (!isNaN(numValue) && numValue < Number(config.min)) {
        return getErrorMessage('min', value, config.min, fieldName);
      }
    }

    if (config.max !== undefined) {
      const numValue = Number(value);
      if (!isNaN(numValue) && numValue > Number(config.max)) {
        return getErrorMessage('max', value, config.max, fieldName);
      }
    }

    // Custom validation
    if (config.custom) {
      const customError = config.custom(value, formData);
      if (customError) {
        return customError;
      }
    }

    return null;
  }, [validationConfig, formData, patterns, getErrorMessage]);

  /**
   * Validate specific field or all fields
   */
  const validate = useCallback(async (fieldName{{#hasTypeScript}}?: string{{/hasTypeScript}}){{#hasTypeScript}}: Promise<boolean>{{/hasTypeScript}} => {
    setIsValidating(true);

    try {
      if (fieldName) {
        // Validate single field
        const error = await validateField(fieldName, formData[fieldName]);
        setErrors(prev => ({
          ...prev,
          [fieldName]: error || '',
