  const getFieldHelperText = useCallback((fieldName{{#hasTypeScript}}: string{{/hasTypeScript}}, helperText{{#hasTypeScript}}?: string{{/hasTypeScript}}){{#hasTypeScript}}: string | undefined{{/hasTypeScript}} => {
    const error = getFieldError(fieldName);
    const isTouched = isFieldTouched(fieldName);

    if (isTouched && error) {
      return error;
    }

    return helperText;
  }, [getFieldError, isFieldTouched]);

  // Auto-validate on form data change
  useEffect(() => {
    if (!validateOnChange) return;

    // Clear existing timer
    if (validationTimer) {
      clearTimeout(validationTimer);
    }

    // Set new timer for debounced validation
    const timer = setTimeout(() => {
      validate();
    }, debounceMs);

    setValidationTimer(timer);

    return () => {
      if (timer) {
        clearTimeout(timer);
      }
    };
  }, [formData, validateOnChange, debounceMs]);

  // Calculate derived state
  const isValid = useMemo(() => {
    return Object.keys(errors).length === 0 || Object.values(errors).every(error => !error);
  }, [errors]);

  const hasErrors = useMemo(() => {
    return Object.values(errors).some(error => Boolean(error));
  }, [errors]);

  const touchedCount = useMemo(() => {
    return Object.values(touched).filter(Boolean).length;
  }, [touched]);

  return {
    errors,
    touched,
    isValid,
    isValidating,
    hasErrors,
    touchedCount,
    validate,
    validateField,
    validateAll,
    clearErrors,
    clearTouched,
    setFieldError,
    setFieldTouched,
    resetValidation,
    getFieldError,
    isFieldTouched,
    isFieldValid,
    getFieldHelperText,
