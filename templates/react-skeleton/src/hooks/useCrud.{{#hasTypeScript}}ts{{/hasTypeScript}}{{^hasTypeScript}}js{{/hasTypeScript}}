  endpoint: string;
  initialPageSize?: number;
  autoFetch?: boolean;
  onSuccess?: (action: string, data?: any) => void;
  onError?: (action: string, error: any) => void;
}

interface ApiResponse<T> {
  data: T[];
  total: number;
  page: number;
  pageSize: number;
}
