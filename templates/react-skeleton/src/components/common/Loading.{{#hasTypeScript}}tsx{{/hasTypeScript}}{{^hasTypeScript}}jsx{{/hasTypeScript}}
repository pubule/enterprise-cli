import { Skeleton } from '@mui/material';

{{#hasTypeScript}}export const ContentSkeleton: React.FC<{
  lines?: number;
  height?: number;
  animation?: 'pulse' | 'wave' | false;
}> = ({{{/hasTypeScript}}{{^hasTypeScript}}export const ContentSkeleton = ({{{/hasTypeScript}}
  lines = 3,
