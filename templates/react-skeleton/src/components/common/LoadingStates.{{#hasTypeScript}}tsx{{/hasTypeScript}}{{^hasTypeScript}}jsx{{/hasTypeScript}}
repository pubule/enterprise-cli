 */
{{#hasTypeScript}}export const ProgressIndicator: React.FC<ProgressIndicatorProps> = ({{{/hasTypeScript}}{{^hasTypeScript}}export const ProgressIndicator = ({{{/hasTypeScript}}
  value = 0,
  indeterminate = false,
