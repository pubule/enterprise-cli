// Base loading props interface
interface BaseLoadingProps {
  size?: 'small' | 'medium' | 'large';
  color?: 'primary' | 'secondary' | 'success' | 'warning' | 'error' | 'info';
  className?: string;
  style?: React.CSSProperties;
}

// Loading spinner props
interface LoadingSpinnerProps extends BaseLoadingProps {
  message?: string;
  fullScreen?: boolean;
  overlay?: boolean;
  delay?: number;
  timeout?: number;
  onTimeout?: () => void;
}

// Skeleton loader props
interface SkeletonLoaderProps extends BaseLoadingProps {
  variant?: 'text' | 'rectangular' | 'circular' | 'rounded';
  animation?: 'pulse' | 'wave' | false;
  width?: number | string;
  height?: number | string;
  count?: number;
}

// Progress indicator props
interface ProgressIndicatorProps extends BaseLoadingProps {
  value?: number;
  indeterminate?: boolean;
  showPercentage?: boolean;
  label?: string;
  variant?: 'linear' | 'circular' | 'dashboard';
  thickness?: number;
  buffer?: number;
}

// Loading state props
interface LoadingStateProps extends BaseLoadingProps {
  loading: boolean;
  error?: string | null;
  empty?: boolean;
  children: React.ReactNode;
  skeleton?: React.ReactNode;
  emptyMessage?: string;
  errorMessage?: string;
  retryButton?: boolean;
  onRetry?: () => void;
  minHeight?: number | string;
  fadeTransition?: boolean;
  delayMs?: number;
}

// Placeholder content props
interface PlaceholderContentProps extends BaseLoadingProps {
  type: 'card' | 'list' | 'table' | 'grid' | 'profile' | 'dashboard' | 'chat' | 'article';
  count?: number;
  animated?: boolean;
}

// Loading overlay props
interface LoadingOverlayProps extends BaseLoadingProps {
  visible: boolean;
  message?: string;
  progress?: number;
  cancelable?: boolean;
  onCancel?: () => void;
  backdrop?: boolean;
  zIndex?: number;
}
