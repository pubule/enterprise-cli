/**
 * Enhanced Loading Spinner Component
 */
{{#hasTypeScript}}export const LoadingSpinner: React.FC<LoadingSpinnerProps> = ({{{/hasTypeScript}}{{^hasTypeScript}}export const LoadingSpinner = ({{{/hasTypeScript}}
  size = 'medium',
  color = 'primary',
  message = 'Loading...',
  fullScreen = false,
  overlay = false,
  delay = 0,
  timeout,
  onTimeout,
  className,
  style,
}) => {
  const [visible, setVisible] = useState(delay === 0);
  const [timedOut, setTimedOut] = useState(false);

  useEffect(() => {
    let delayTimer{{#hasTypeScript}}: NodeJS.Timeout{{/hasTypeScript}};
    let timeoutTimer{{#hasTypeScript}}: NodeJS.Timeout{{/hasTypeScript}};

    if (delay > 0) {
      delayTimer = setTimeout(() => setVisible(true), delay);
    }

    if (timeout) {
      timeoutTimer = setTimeout(() => {
        setTimedOut(true);
        onTimeout?.();
      }, timeout);
    }

    return () => {
      clearTimeout(delayTimer);
      clearTimeout(timeoutTimer);
    };
  }, [delay, timeout, onTimeout]);

  if (!visible || timedOut) {
    return null;
  }

  const sizeMap = {
    small: {{#isMaterialUI}}20{{/isMaterialUI}}{{#isAntDesign}}16{{/isAntDesign}},
    medium: {{#isMaterialUI}}40{{/isMaterialUI}}{{#isAntDesign}}24{{/isAntDesign}},
    large: {{#isMaterialUI}}60{{/isMaterialUI}}{{#isAntDesign}}32{{/isAntDesign}},
  };

  const spinnerSize = sizeMap[size];

  {{#isMaterialUI}}
  const content = (
    <Box
      className={className}
      style={style}
      sx={{
        display: 'flex',
        flexDirection: 'column',
        alignItems: 'center',
        justifyContent: 'center',
        gap: 2,
        ...(fullScreen && {
          position: 'fixed',
          top: 0,
          left: 0,
          right: 0,
          bottom: 0,
          zIndex: 9999,
          backgroundColor: 'rgba(255, 255, 255, 0.8)',
        }),
        ...(overlay && {
          position: 'absolute',
          top: 0,
          left: 0,
          right: 0,
          bottom: 0,
          backgroundColor: 'rgba(255, 255, 255, 0.8)',
          zIndex: 1000,
        }),
      }}
    >
      <CircularProgress size={spinnerSize} color={color} />
      {message && (
        <Typography variant="body2" color="text.secondary">
          {message}
        </Typography>
      )}
    </Box>
  );

  if (fullScreen) {
    return (
      <Backdrop open={true} sx={{ zIndex: 9999 }}>
        {content}
      </Backdrop>
    );
  }

  return content;{{/isMaterialUI}}

  {{#isAntDesign}}
  const content = (
    <div
      className={className}
      style={{
        display: 'flex',
        flexDirection: 'column',
        alignItems: 'center',
        justifyContent: 'center',
        gap: 16,
        ...(fullScreen && {
          position: 'fixed',
          top: 0,
          left: 0,
          right: 0,
          bottom: 0,
          zIndex: 9999,
          backgroundColor: 'rgba(255, 255, 255, 0.8)',
        }),
        ...(overlay && {
          position: 'absolute',
          top: 0,
          left: 0,
          right: 0,
          bottom: 0,
          backgroundColor: 'rgba(255, 255, 255, 0.8)',
          zIndex: 1000,
        }),
        ...style,
      }}
    >
      <Spin size={size} />
      {message && <Text type="secondary">{message}</Text>}
    </div>
  );

  return content;{{/isAntDesign}}
};

