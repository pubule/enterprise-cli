/**
 * Comprehensive Loading State Component
 */
{{#hasTypeScript}}export const LoadingState: React.FC<LoadingStateProps> = ({{{/hasTypeScript}}{{^hasTypeScript}}export const LoadingState = ({{{/hasTypeScript}}
  loading,
  error = null,
  empty = false,
  children,
  skeleton,
  emptyMessage = 'No data available',
  errorMessage = 'An error occurred',
  retryButton = true,
  onRetry,
  minHeight = 200,
  fadeTransition = true,
  delayMs = 100,
  className,
  style,
}) => {
  const [delayedLoading, setDelayedLoading] = useState(loading);

  useEffect(() => {
    if (loading) {
      setDelayedLoading(true);
    } else {
      const timer = setTimeout(() => setDelayedLoading(false), delayMs);
      return () => clearTimeout(timer);
    }
  }, [loading, delayMs]);

  const containerStyle = {
    minHeight,
    ...style,
  };

  // Error state
  if (error) {
    {{#isMaterialUI}}
    return (
      <Box
        className={className}
        style={containerStyle}
        sx={{
          display: 'flex',
          flexDirection: 'column',
          alignItems: 'center',
          justifyContent: 'center',
          p: 3,
        }}
      >
        <Typography color="error" gutterBottom>
          {errorMessage}
        </Typography>
        <Typography variant="body2" color="text.secondary" sx={{ mb: 2 }}>
          {error}
        </Typography>
        {retryButton && onRetry && (
          <Button variant="outlined" onClick={onRetry} startIcon={<Refresh />}>
            Retry
          </Button>
        )}
      </Box>
    );{{/isMaterialUI}}

    {{#isAntDesign}}
    return (
      <div className={className} style={containerStyle}>
        <Result
          status="error"
          title={errorMessage}
          subTitle={error}
          extra={
            retryButton && onRetry && (
              <Button type="primary" onClick={onRetry} icon={<SyncOutlined />}>
                Retry
              </Button>
            )
          }
        />
      </div>
    );{{/isAntDesign}}
  }

  // Loading state
  if (delayedLoading) {
    const loadingContent = skeleton || (
      <LoadingSpinner message="Loading..." />
    );

    {{#isMaterialUI}}
    return (
      <Box className={className} style={containerStyle}>
        {fadeTransition ? (
          <Fade in={delayedLoading}>{loadingContent}</Fade>
        ) : (
          loadingContent
        )}
      </Box>
    );{{/isMaterialUI}}

    {{#isAntDesign}}
    return (
      <div className={className} style={containerStyle}>
        {loadingContent}
      </div>
    );{{/isAntDesign}}
  }

  // Empty state
  if (empty) {
    {{#isMaterialUI}}
    return (
      <Box
        className={className}
        style={containerStyle}
        sx={{
          display: 'flex',
          flexDirection: 'column',
          alignItems: 'center',
          justifyContent: 'center',
          p: 3,
        }}
      >
        <Typography variant="h6" color="text.secondary" gutterBottom>
          {emptyMessage}
        </Typography>
      </Box>
    );{{/isMaterialUI}}

    {{#isAntDesign}}
    return (
      <div className={className} style={containerStyle}>
        <Empty description={emptyMessage} />
      </div>
    );{{/isAntDesign}}
  }

  // Content state
  {{#isMaterialUI}}
  return (
    <Box className={className} style={containerStyle}>
      {fadeTransition ? (
        <Fade in={!delayedLoading}>{children}</Fade>
      ) : (
        children
      )}
    </Box>
  );{{/isMaterialUI}}

  {{#isAntDesign}}
  return (
    <div className={className} style={containerStyle}>
      {children}
    </div>
  );{{/isAntDesign}}
};

