/**
 * Enhanced Phone Number Input Component
 */
{{#hasTypeScript}}export const PhoneInput: React.FC<PhoneInputProps> = ({{{/hasTypeScript}}{{^hasTypeScript}}export const PhoneInput = ({{{/hasTypeScript}}
  label = 'Phone Number',
  value = '',
  onChange,
  onBlur,
  error = false,
  helperText,
  disabled = false,
  required = false,
  placeholder = 'Enter phone number',
  fullWidth = true,
  size = 'medium',
  country = 'US',
  format = 'national',
  enableCountrySelect = true,
}) => {
  const [phoneValue, setPhoneValue] = useState(value);

  const formatPhoneNumber = useCallback((input{{#hasTypeScript}}: string{{/hasTypeScript}}) => {
    // Basic phone formatting logic - can be enhanced with libraries like libphonenumber
    const cleaned = input.replace(/\D/g, '');

    if (format === 'e164') {
      return cleaned.length > 0 ? `+${cleaned}` : '';
    }

    if (format === 'international') {
      if (cleaned.length >= 10) {
        return `+${cleaned.slice(0, 1)} (${cleaned.slice(1, 4)}) ${cleaned.slice(4, 7)}-${cleaned.slice(7, 11)}`;
      }
    }

    // National format (default)
    if (cleaned.length >= 10) {
      return `(${cleaned.slice(0, 3)}) ${cleaned.slice(3, 6)}-${cleaned.slice(6, 10)}`;
    }

    return cleaned;
  }, [format]);

  const handleChange = useCallback((newValue{{#hasTypeScript}}: string{{/hasTypeScript}}) => {
    const formatted = formatPhoneNumber(newValue);
    setPhoneValue(formatted);
    onChange?.(formatted);
  }, [formatPhoneNumber, onChange]);

  {{#isMaterialUI}}
  return (
    <TextField
      label={label}
      value={phoneValue}
      onChange={(e) => handleChange(e.target.value)}
      onBlur={onBlur}
      error={error}
      helperText={helperText}
      disabled={disabled}
      required={required}
      placeholder={placeholder}
      fullWidth={fullWidth}
      size={size}
      InputProps={{
        startAdornment: enableCountrySelect && (
          <InputAdornment position="start">
            <Typography variant="body2">+1</Typography>
          </InputAdornment>
        ),
      }}
    />
  );{{/isMaterialUI}}

  {{#isAntDesign}}
  return (
    <Form.Item
      label={label}
      validateStatus={error ? 'error' : ''}
      help={helperText}
      required={required}
    >
      <Input
        value={phoneValue}
        onChange={(e) => handleChange(e.target.value)}
        onBlur={onBlur}
        disabled={disabled}
        placeholder={placeholder}
        size={size}
        addonBefore={enableCountrySelect ? '+1' : undefined}
      />
    </Form.Item>
  );{{/isAntDesign}}
};

/**
 * Currency Input Component
 */
{{#hasTypeScript}}export const CurrencyInput: React.FC<CurrencyInputProps> = ({{{/hasTypeScript}}{{^hasTypeScript}}export const CurrencyInput = ({{{/hasTypeScript}}
  label = 'Amount',
  value = 0,
  onChange,
  onBlur,
  error = false,
  helperText,
  disabled = false,
  required = false,
  placeholder = '0.00',
  fullWidth = true,
  size = 'medium',
  currency = 'USD',
  locale = 'en-US',
  precision = 2,
  allowNegative = false,
}) => {
  const [displayValue, setDisplayValue] = useState('');

  useEffect(() => {
    if (value !== undefined && value !== null) {
      const formatted = new Intl.NumberFormat(locale, {
        style: 'currency',
        currency: currency,
        minimumFractionDigits: precision,
        maximumFractionDigits: precision,
      }).format(value);
      setDisplayValue(formatted);
    }
  }, [value, locale, currency, precision]);

  const handleChange = useCallback((newValue{{#hasTypeScript}}: string{{/hasTypeScript}}) => {
    // Remove currency symbols and parse
    const cleaned = newValue.replace(/[^\d.-]/g, '');
    const numValue = parseFloat(cleaned) || 0;

    if (!allowNegative && numValue < 0) {
      return;
    }

    onChange?.(numValue);
  }, [onChange, allowNegative]);

  {{#isMaterialUI}}
  return (
    <TextField
      label={label}
      value={displayValue}
      onChange={(e) => handleChange(e.target.value)}
      onBlur={onBlur}
      error={error}
      helperText={helperText}
      disabled={disabled}
      required={required}
      placeholder={placeholder}
      fullWidth={fullWidth}
      size={size}
      InputProps={{
        startAdornment: (
          <InputAdornment position="start">
            <Typography variant="body2">{currency}</Typography>
          </InputAdornment>
        ),
      }}
    />
  );{{/isMaterialUI}}

  {{#isAntDesign}}
  return (
    <Form.Item
      label={label}
      validateStatus={error ? 'error' : ''}
      help={helperText}
      required={required}
    >
      <InputNumber
        value={value}
        onChange={onChange}
        onBlur={onBlur}
        disabled={disabled}
        placeholder={placeholder}
        size={size}
        formatter={(value) => `${currency} ${value}`.replace(/\B(?=(\d{3})+(?!\d))/g, ',')}
        parser={(value) => value?.replace(/\$\s?|(,*)/g, '') || ''}
        precision={precision}
        min={allowNegative ? undefined : 0}
        style={{ width: fullWidth ? '100%' : undefined }}
      />
    </Form.Item>
  );{{/isAntDesign}}
};

