/**
 * Tag Input Component
 */
{{#hasTypeScript}}export const TagInput: React.FC<TagInputProps> = ({{{/hasTypeScript}}{{^hasTypeScript}}export const TagInput = ({{{/hasTypeScript}}
  label = 'Tags',
  value = [],
  onChange,
  error = false,
  helperText,
  disabled = false,
  required = false,
  placeholder = 'Add tags...',
  fullWidth = true,
  suggestions = [],
  allowDuplicates = false,
  maxTags,
  validateTag,
}) => {
  const [inputValue, setInputValue] = useState('');
  const [tags, setTags] = useState(value || []);

  const addTag = useCallback((tag{{#hasTypeScript}}: string{{/hasTypeScript}}) => {
    const trimmedTag = tag.trim();
    if (!trimmedTag) return;

    if (!allowDuplicates && tags.includes(trimmedTag)) return;
    if (maxTags && tags.length >= maxTags) return;
    if (validateTag && !validateTag(trimmedTag)) return;

    const newTags = [...tags, trimmedTag];
    setTags(newTags);
    onChange?.(newTags);
    setInputValue('');
  }, [tags, onChange, allowDuplicates, maxTags, validateTag]);

  const removeTag = useCallback((index{{#hasTypeScript}}: number{{/hasTypeScript}}) => {
    const newTags = tags.filter((_, i) => i !== index);
    setTags(newTags);
    onChange?.(newTags);
  }, [tags, onChange]);

  const handleKeyDown = useCallback((event{{#hasTypeScript}}: React.KeyboardEvent{{/hasTypeScript}}) => {
    if (event.key === 'Enter' || event.key === ',') {
      event.preventDefault();
      addTag(inputValue);
    } else if (event.key === 'Backspace' && !inputValue && tags.length > 0) {
      removeTag(tags.length - 1);
    }
  }, [inputValue, addTag, removeTag, tags]);

  {{#isMaterialUI}}
  return (
    <FormControl fullWidth={fullWidth} error={error}>
      <FormLabel>{label}</FormLabel>
      <Paper
        variant="outlined"
        sx={{
          p: 1,
          mt: 1,
          minHeight: 56,
          display: 'flex',
          flexWrap: 'wrap',
          gap: 0.5,
          alignItems: 'center',
        }}
      >
        {tags.map((tag, index) => (
          <Chip
            key={index}
            label={tag}
            onDelete={disabled ? undefined : () => removeTag(index)}
            size="small"
            color="primary"
          />
        ))}
        <TextField
          value={inputValue}
          onChange={(e) => setInputValue(e.target.value)}
          onKeyDown={handleKeyDown}
          placeholder={placeholder}
          disabled={disabled}
          variant="standard"
          InputProps={{ disableUnderline: true }}
          sx={{ flexGrow: 1, minWidth: 120 }}
        />
      </Paper>
      {helperText && <FormHelperText>{helperText}</FormHelperText>}
    </FormControl>
  );{{/isMaterialUI}}

  {{#isAntDesign}}
  return (
    <Form.Item
      label={label}
      validateStatus={error ? 'error' : ''}
      help={helperText}
      required={required}
    >
      <div style={{
        border: '1px solid #d9d9d9',
        borderRadius: 6,
        padding: 8,
        minHeight: 32,
        display: 'flex',
        flexWrap: 'wrap',
        gap: 4,
        alignItems: 'center'
      }}>
        {tags.map((tag, index) => (
          <Tag
            key={index}
            closable={!disabled}
            onClose={() => removeTag(index)}
            color="blue"
          >
            {tag}
          </Tag>
        ))}
        <Input
          value={inputValue}
          onChange={(e) => setInputValue(e.target.value)}
          onKeyDown={handleKeyDown}
          placeholder={placeholder}
          disabled={disabled}
          bordered={false}
          size="small"
          style={{ flex: 1, minWidth: 120 }}
        />
      </div>
    </Form.Item>
  );{{/isAntDesign}}
};

/**
 * File Upload Component
 */
{{#hasTypeScript}}export const FileUpload: React.FC<FileUploadProps> = ({{{/hasTypeScript}}{{^hasTypeScript}}export const FileUpload = ({{{/hasTypeScript}}
  label = 'Upload Files',
  value = [],
  onChange,
  error = false,
  helperText,
  disabled = false,
  required = false,
  accept = '*/*',
  multiple = false,
  maxSize = 10, // 10MB
  maxFiles = 5,
  showPreview = true,
  onUpload,
}) => {
  const [files, setFiles] = useState(value || []);
  const [uploading, setUploading] = useState(false);
  const [uploadProgress, setUploadProgress] = useState(0);
  const fileInputRef = useRef{{#hasTypeScript}}<HTMLInputElement>{{/hasTypeScript}}(null);

  const handleFileSelect = useCallback(async (selectedFiles{{#hasTypeScript}}: FileList | null{{/hasTypeScript}}) => {
    if (!selectedFiles) return;

    const fileArray = Array.from(selectedFiles);

    // Validate file size
    const oversizedFiles = fileArray.filter(file => file.size > maxSize * 1024 * 1024);
    if (oversizedFiles.length > 0) {
      alert(`Some files exceed the ${maxSize}MB limit`);
      return;
    }

    // Validate file count
    if (maxFiles && files.length + fileArray.length > maxFiles) {
      alert(`Maximum ${maxFiles} files allowed`);
      return;
    }

    if (onUpload) {
      setUploading(true);
      try {
        const urls = await onUpload(fileArray);
        const newFiles = fileArray.map((file, index) => ({
          name: file.name,
          size: file.size,
          type: file.type,
          url: urls[index],
          file,
        }));
        const updatedFiles = multiple ? [...files, ...newFiles] : newFiles;
        setFiles(updatedFiles);
        onChange?.(updatedFiles);
      } catch (error) {
        console.error('Upload failed:', error);
      } finally {
        setUploading(false);
        setUploadProgress(0);
      }
    } else {
      const newFiles = fileArray.map(file => ({
        name: file.name,
        size: file.size,
        type: file.type,
        file,
      }));
      const updatedFiles = multiple ? [...files, ...newFiles] : newFiles;
      setFiles(updatedFiles);
      onChange?.(updatedFiles);
    }
  }, [files, onChange, multiple, maxSize, maxFiles, onUpload]);

  const removeFile = useCallback((index{{#hasTypeScript}}: number{{/hasTypeScript}}) => {
    const newFiles = files.filter((_, i) => i !== index);
    setFiles(newFiles);
    onChange?.(newFiles);
  }, [files, onChange]);

  {{#isMaterialUI}}
  return (
    <FormControl fullWidth error={error}>
      <FormLabel>{label}</FormLabel>
      <Box sx={{ mt: 1 }}>
        <input
          ref={fileInputRef}
          type="file"
          accept={accept}
          multiple={multiple}
          onChange={(e) => handleFileSelect(e.target.files)}
          style={{ display: 'none' }}
          disabled={disabled}
        />

        <Button
          variant="outlined"
          onClick={() => fileInputRef.current?.click()}
          disabled={disabled || uploading}
          startIcon={<Upload />}
          fullWidth
        >
          {uploading ? 'Uploading...' : 'Choose Files'}
        </Button>

        {uploading && (
          <Box sx={{ mt: 1 }}>
            <LinearProgress variant="determinate" value={uploadProgress} />
          </Box>
        )}

        {showPreview && files.length > 0 && (
          <Box sx={{ mt: 2 }}>
            {files.map((file, index) => (
              <Box
                key={index}
                sx={{
                  display: 'flex',
                  alignItems: 'center',
                  justifyContent: 'space-between',
                  p: 1,
                  border: '1px solid #ddd',
                  borderRadius: 1,
                  mb: 1,
                }}
              >
                <Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                  {file.type?.startsWith('image/') && file.url && (
                    <Avatar src={file.url} sx={{ width: 40, height: 40 }} />
                  )}
                  <Box>
                    <Typography variant="body2">{file.name}</Typography>
                    <Typography variant="caption" color="text.secondary">
                      {(file.size / 1024 / 1024).toFixed(2)} MB
                    </Typography>
                  </Box>
                </Box>
                <IconButton
                  size="small"
                  onClick={() => removeFile(index)}
                  disabled={disabled}
                  color="error"
                >
                  <Delete />
                </IconButton>
              </Box>
            ))}
          </Box>
        )}
      </Box>
      {helperText && <FormHelperText>{helperText}</FormHelperText>}
    </FormControl>
  );{{/isMaterialUI}}

  {{#isAntDesign}}
  return (
    <Form.Item
      label={label}
      validateStatus={error ? 'error' : ''}
      help={helperText}
      required={required}
    >
      <Upload
        accept={accept}
        multiple={multiple}
        disabled={disabled}
        beforeUpload={() => false} // Prevent automatic upload
        onChange={(info) => {
          const fileList = info.fileList.map(file => ({
            name: file.name,
            size: file.size || 0,
            type: file.type || '',
            file: file.originFileObj,
          }));
          setFiles(fileList);
          onChange?.(fileList);
        }}
        onRemove={(file) => {
          const index = files.findIndex(f => f.name === file.name);
          if (index > -1) removeFile(index);
        }}
        showUploadList={showPreview}
      >
        <Button icon={<UploadOutlined />} loading={uploading}>
          {uploading ? 'Uploading...' : 'Choose Files'}
        </Button>
      </Upload>

      {uploading && (
        <Progress percent={uploadProgress} size="small" style={{ marginTop: 8 }} />
      )}
    </Form.Item>
  );{{/isAntDesign}}
};

