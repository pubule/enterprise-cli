// Base props interface for all specialized inputs
interface BaseInputProps {
  label?: string;
  value?: any;
  onChange?: (value: any) => void;
  onBlur?: () => void;
  error?: boolean;
  helperText?: string;
  disabled?: boolean;
  required?: boolean;
  placeholder?: string;
  fullWidth?: boolean;
  size?: 'small' | 'medium' | 'large';
}

// Phone Input Props
interface PhoneInputProps extends BaseInputProps {
  country?: string;
  format?: 'international' | 'national' | 'e164';
  enableCountrySelect?: boolean;
}

// Currency Input Props
interface CurrencyInputProps extends BaseInputProps {
  currency?: string;
  locale?: string;
  precision?: number;
  allowNegative?: boolean;
}

// Color Picker Props
interface ColorPickerProps extends BaseInputProps {
  format?: 'hex' | 'rgb' | 'hsl';
  showPresets?: boolean;
  presetColors?: string[];
}

// Tag Input Props
interface TagInputProps extends BaseInputProps {
  value?: string[];
  suggestions?: string[];
  allowDuplicates?: boolean;
  maxTags?: number;
  validateTag?: (tag: string) => boolean;
}

// File Upload Props
interface FileUploadProps extends BaseInputProps {
  accept?: string;
  multiple?: boolean;
  maxSize?: number; // in MB
  maxFiles?: number;
  showPreview?: boolean;
  onUpload?: (files: File[]) => Promise<string[]>; // Returns URLs
}

// Range Input Props
interface RangeInputProps extends BaseInputProps {
  min?: number;
  max?: number;
  step?: number;
  marks?: boolean | Record<number, string>;
  showValue?: boolean;
  formatValue?: (value: number) => string;
}

// Search Input Props
interface SearchInputProps extends BaseInputProps {
  onSearch?: (value: string) => void;
  suggestions?: string[];
  loading?: boolean;
  debounceMs?: number;
}
