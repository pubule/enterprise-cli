                </div>
              </Space>
            </Dropdown>
          </Space>
        </Header>

        <Content style={{
          margin: '24px 16px',
          padding: 24,
          background: '#fff',
          borderRadius: 6,
          minHeight: 280
        }}>
          {{#hasRouter}}<Outlet />{{/hasRouter}}
          {{^hasRouter}}<div>Main content area</div>{{/hasRouter}}
