// Hook for conditional rendering based on roles
export const useRoleAccess = () => {
  const { hasRole, hasPermission, user } = useAuth();

  const canAccess = (role{{#hasTypeScript}}: string{{/hasTypeScript}}) => hasRole(role);
  const canPerform = (permission{{#hasTypeScript}}: string{{/hasTypeScript}}) => hasPermission(permission);
  const isAdmin = () => hasRole('admin') || hasRole('administrator');
  const isModerator = () => hasRole('moderator') || isAdmin();
