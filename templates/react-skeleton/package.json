{
  "name": "{{appName}}",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise React Application - {{appNamePascalCase}}",
  "keywords": ["react", "typescript", "enterprise", "{{appName}}"],
  "author": "Enterprise Development Team",
  "license": "MIT",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"{{#hasTypeScript}},
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0"{{/hasTypeScript}}{{#hasRedux}},
    "@reduxjs/toolkit": "^1.9.0",
    "react-redux": "^8.1.0"{{/hasRedux}}{{#hasRouter}},
    "react-router-dom": "^6.15.0"{{/hasRouter}}{{#hasForms}},
    "react-hook-form": "^7.45.0"{{/hasForms}}{{#hasReactQuery}},
    "@tanstack/react-query": "^4.32.0",
    "@tanstack/react-query-devtools": "^4.32.0"{{/hasReactQuery}}{{#isMaterialUI}},
    "@mui/material": "^5.14.0",
    "@mui/icons-material": "^5.14.0",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0"{{/isMaterialUI}}{{#isAntDesign}},
    "antd": "^5.8.0"{{/isAntDesign}}
  },
  "devDependencies": {
    {{#hasTypeScript}}
    "typescript": "^5.0.0",
    {{/hasTypeScript}}
    {{#isVite}}
    "@vitejs/plugin-react": "^4.0.0",
    "vite": "^4.4.0",
    {{/isVite}}
    {{#isCRA}}
    "react-scripts": "5.0.1",
    {{/isCRA}}
    {{#hasTesting}}
    "@testing-library/react": "^13.4.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/user-event": "^14.4.0",
    {{/hasTesting}}
    {{#hasCypress}}
    "cypress": "^13.0.0",
    {{/hasCypress}}
    {{#hasLinting}}
    "eslint": "^8.48.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.0.0",
    {{#hasTypeScript}}
    "@typescript-eslint/parser": "^6.6.0",
    "@typescript-eslint/eslint-plugin": "^6.6.0",
    {{/hasTypeScript}}
    {{/hasLinting}}
    "web-vitals": "^3.4.0"
  },
  "scripts": {
    {{#isVite}}
    "dev": "vite",
    "build": "{{#hasTypeScript}}tsc && {{/hasTypeScript}}vite build",
    "preview": "vite preview",
    {{/isVite}}
    {{#isCRA}}
    "start": "react-scripts start",
    "build": "react-scripts build",
    "eject": "react-scripts eject",
    {{/isCRA}}
    {{#hasTesting}}
    "test": "{{#isVite}}vitest{{/isVite}}{{#isCRA}}react-scripts test{{/isCRA}}",
    "test:coverage": "{{#isVite}}vitest --coverage{{/isVite}}{{#isCRA}}react-scripts test --coverage --watchAll=false{{/isCRA}}",
    {{/hasTesting}}
    {{#hasCypress}}
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    {{/hasCypress}}
    {{#hasLinting}}
    "lint": "eslint src --ext .js,.jsx{{#hasTypeScript}},.ts,.tsx{{/hasTypeScript}}",
    "lint:fix": "eslint src --ext .js,.jsx{{#hasTypeScript}},.ts,.tsx{{/hasTypeScript}} --fix",
    "format": "prettier --write src/**/*.{js,jsx{{#hasTypeScript}},ts,tsx{{/hasTypeScript}},json,css,md}",
    {{/hasLinting}}
    "analyze": "npm run build && npx bundle-analyzer build/static/js/*.js"
  },
  "eslintConfig": {
    {{#hasLinting}}
    "extends": [
      "react-app",
      "react-app/jest"{{#hasTypeScript}},
      "@typescript-eslint/recommended"{{/hasTypeScript}}
    ],
    "plugins": [
      "react",
      "react-hooks"{{#hasTypeScript}},
      "@typescript-eslint"{{/hasTypeScript}}
    ],
    "rules": {
      "react-hooks/rules-of-hooks": "error",
      "react-hooks/exhaustive-deps": "warn"{{#hasTypeScript}},
      "@typescript-eslint/explicit-function-return-type": "off",
      "@typescript-eslint/no-explicit-any": "warn"{{/hasTypeScript}}
    }
    {{/hasLinting}}
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "{{apiBaseUrl}}"
}